{
	"name": "wc",
	"version": "1.5.40-SNAPSHOT",
	"description": "Client side code for WComponents UI tool kit.",
	"private": true,
	"type": "module",
	"com_github_bordertech": {
		"description": "Custom config here. JSON has no comment syntax, argh!",
		"testMinOrMax": "max",
		"name": "wcomponents-theme"
	},
	"scripts": {
		"build": "node build-images.mjs && node build-resource.mjs && node build-css.mjs && node build-js.mjs",
		"build:css": "node build-css.mjs",
		"build:img": "node build-images.mjs",
		"build:js": "node build-js.mjs",
		"build:dist": "rollup --config",
		"build:types": "tsc --project tsconfig.json",
		"doc": "npm run jsdoc",
		"eslint": "eslint --config eslint.config.mjs .",
		"eslint:report": "npm run eslint -- --format html --output-file ./target/reports/eslint-report.html",
		"jasmine": "jasmine --config=jasmine.json",
		"jsdoc": "jsdoc -c jsdoc.config.json",
		"lint": "node ./scripts/lintfile.mjs",
		"sass-lint": "sass-lint --config .sass-lint.yml '**/!(fa)/*.scss'",
		"test": "npm run jasmine",
		"test:coverage": "c8 --config .nycrc.json npm test",
		"watch": "node ./scripts/theme-watch.mjs"
	},
	"directories": {
		"src": "src/main",
		"test": "src/test",
		"target": "target"
	},
	"exports": {
		"./*": "./src/main/js/wc/*"
	},
	"main": "src/main/js/wc/common.mjs",
	"dependencies": {
		"fabric": "5.3.0",
		"i18next": "23.5.1",
		"mailcheck": "1.1.1",
		"requirejs": "2.3.6",
		"socket.io": "4.7.2",
		"sprintf-js": "1.1.3",
		"tinymce": "6.3.1"
	},
	"devDependencies": {
		"@babel/cli": "7.20.7",
		"@babel/core": "7.20.12",
		"@eslint/js": "9.39.4",
		"@rollup/plugin-commonjs": "25.0.7",
		"@rollup/plugin-node-resolve": "15.2.3",
		"@stylistic/eslint-plugin": "5.10.0",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jasmine-dom": "1.3.3",
		"@types/fabric": "5.3.0",
		"@types/fs-extra": "11.0.1",
		"@types/jasmine": "6.0.0",
		"@types/jasmine-ajax": "3.3.5",
		"@types/jsdom": "27.0.0",
		"@types/node": "22.19.20",
		"@types/sass": "1.45.0",
		"@types/socket.io": "3.0.2",
		"@types/testing-library__jasmine-dom": "1.3.4",
		"@types/uglify-js": "3.17.5",
		"axe-core": "3.0.0",
		"babel-plugin-transform-commonjs": "1.1.6",
		"babel-plugin-transform-import-as-amd": "0.0.12",
		"c8": "8.0.1",
		"chokidar": "3.5.3",
		"clean-css-cli": "4.1.11",
		"eslint": "9.39.4",
		"eslint-plugin-jasmine": "4.2.2",
		"eslint-plugin-jsdoc": "61.7.1",
		"eslint-plugin-sonarjs": "4.0.3",
		"fs-extra": "8.1.0",
		"global-jsdom": "24.0.0",
		"jasmine": "6.2.0",
		"jasmine-ajax": "4.0.0",
		"jasmine-axe": "1.1.0",
		"jsdoc": "4.0.5",
		"jsdom": "24.0.0",
		"properties": "1.2.1",
		"rollup": "4.4.0",
		"sass": "1.5.1",
		"sass-lint": "1.13.1",
		"typescript": "5.9.3",
		"uglify-js": "3.19.3"
	},
	"overrides": {
		"babel-plugin-transform-commonjs": {
			"globals": "17.6.0"
		}
	}
}
