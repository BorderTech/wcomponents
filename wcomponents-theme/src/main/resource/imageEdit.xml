<div class="wc-row">
	<div class="wc_img_editpane wc-column">
		<div class="wc_img_canvas">
			<canvas id="wc_img_canvas"></canvas>
		</div>
	</div>
	<div class="wc_img_cap wc-column" style="height: {{style.height}}px">
		<div id="wc_img_video_container"></div>
		<button title="{{imgedit_message_snap}}" type="button" class="wc_btn_snap {{style.btnclass}}" name="snap"><i aria-hidden="true" class="wc-fa fa-solid fa-camera"></i><span class="{{style.textclass}}">{{imgedit_action_snap}}</span></button>
	</div>
	<div class="wc_img_nocap wc-column">
		<p>{{imgedit_message_nocapture}}</p>
	</div>
	<div class="wc_img_controls wc-column">
		{{#feature.rotate}}
		<fieldset>
			<legend>{{imgedit_rotate}}</legend>
			<button title="{{imgedit_message_rotate_left90}}" type="button" class="wc_btn_anticlock90 {{style.btnclass}}" name="anticlock90"><i aria-hidden="true" class="wc-fa fa-solid fa-backward-step"></i><span class="{{style.textclass}}">{{imgedit_rotate_left90}}</span></button>
			<button title="{{imgedit_message_rotate_left}}" type="button" class="wc_btn_anticlock {{style.btnclass}}" name="anticlock"><i aria-hidden="true" class="wc-fa fa-solid fa-arrow-rotate-left"></i><span class="{{style.textclass}}">{{imgedit_rotate_left}}</span></button>
			<button title="{{imgedit_message_rotate_right}}" type="button" class="wc_btn_clock {{style.btnclass}}" name="clock"><i aria-hidden="true" class="wc-fa fa-solid fa-arrow-rotate-right"></i><span class="{{style.textclass}}">{{imgedit_rotate_right}}</span></button>
			<button title="{{imgedit_message_rotate_right90}}" type="button" class="wc_btn_clock90 {{style.btnclass}}" name="clock90"><i aria-hidden="true" class="wc-fa fa-solid fa-forward-step"></i><span class="{{style.textclass}}">{{imgedit_rotate_right90}}</span></button>
		</fieldset>
		{{/feature.rotate}}
		{{#feature.zoom}}
		<fieldset>
			<legend>{{imgedit_zoom}}</legend>
			<button title="{{imgedit_message_zoom_out}}" type="button" class="wc_btn_out {{style.btnclass}}" name="out"><i aria-hidden="true" class="wc-fa fa-solid fa-magnifying-glass-minus"></i><span class="{{style.textclass}}">{{imgedit_zoom_out}}</span></button>
			<button title="{{imgedit_message_zoom_in}}" type="button" class="wc_btn_in {{style.btnclass}}" name="in"><i aria-hidden="true" class="wc-fa fa-solid fa-magnifying-glass-plus"></i><span class="{{style.textclass}}">{{imgedit_zoom_in}}</span></button>
			{{#feature.face}}
			<button title="{{message.face}}" type="button" class="wc_btn_face {{style.btnclass}}" name="face"><i aria-hidden="true" class="wc-fa fa-solid fa-user"></i><span class="{{style.textclass}}">{{action.face}}</span></button>
			{{/feature.face}}
		</fieldset>
		{{/feature.zoom}}
		{{#feature.move}}
		<fieldset class="wc_img_buttons">
			<legend>{{imgedit_move}}</legend>
			<button title="{{imgedit_message_move_up}}" type="button" class="wc_btn_up {{style.btnclass}}" name="up"><i aria-hidden="true" class="wc-fa fa-solid fa-caret-up"></i><span class="{{style.textclass}}">{{imgedit_move_up}}</span></button>
			<button title="{{imgedit_message_move_left}}" type="button" class="wc_btn_left {{style.btnclass}}" name="left"><i aria-hidden="true" class="wc-fa fa-solid fa-caret-left"></i><span class="{{style.textclass}}">{{imgedit_move_left}}</span></button>
			<button title="{{imgedit_message_move_center}}" type="button" class="wc_btn_center {{style.btnclass}}" name="center"><i aria-hidden="true" class="wc-fa fa-solid fa-bullseye"></i><span class="{{style.textclass}}">{{imgedit_move_center}}</span></button>
			<button title="{{imgedit_message_move_right}}" type="button" class="wc_btn_right {{style.btnclass}}" name="right"><i aria-hidden="true" class="wc-fa fa-solid fa-caret-right"></i><span class="{{style.textclass}}">{{imgedit_move_right}}</span></button>
			<button title="{{imgedit_message_move_down}}" type="button" class="wc_btn_down {{style.btnclass}}" name="down"><i aria-hidden="true" class="wc-fa fa-solid fa-caret-down"></i><span class="{{style.textclass}}">{{imgedit_move_down}}</span></button>
		</fieldset>
		{{/feature.move}}
		{{#feature.redact}}
		<fieldset>
			<legend>{{imgedit_redact}}</legend>
			<label>{{imgedit_action_redact}}
				<input title="{{imgedit_message_redact}}" type="checkbox" name="redact"/>
			</label>
		</fieldset>
		{{/feature.redact}}
		<fieldset class="wc_img_capture">
			<legend>{{imgedit_capture}}</legend>
			<button title="{{imgedit_message_camera}}" type="button" class="wc_btn_camera {{style.btnclass}}" name="camera"><i aria-hidden="true" class="wc-fa fa-solid fa-video"></i><span class="{{style.textclass}}">{{imgedit_action_camera}}</span></button>
		</fieldset>
		{{#feature.reset}}
		<div>
			<button title="{{imgedit_message_reset}}" type="button" name="reset">{{imgedit_action_reset}}</button>
		</div>
		{{/feature.reset}}
		<div>
			{{#feature.undo}}
			<button title="{{imgedit_message_undo}}" type="button" class="wc_btn_undo {{style.btnclass}}" name="undo"><i aria-hidden="true" class="wc-fa fa-solid fa-reply"></i><span class="{{style.textclass}}">{{imgedit_action_undo}}</span></button>
			<button title="{{imgedit_message_redo}}" type="button" class="wc_btn_redo {{style.btnclass}}" name="redo"><i aria-hidden="true" class="wc-fa fa-solid fa-share"></i><span class="{{style.textclass}}">{{imgedit_action_redo}}</span></button>
			{{/feature.undo}}
			{{#feature.cancel}}
			<button title="{{imgedit_message_cancel}}" type="button" class="wc_btn_cancel {{style.btnclass}}" name="cancel"><i aria-hidden="true" class="wc-fa fa-solid fa-trash-can"></i><span class="{{style.textclass}}">{{imgedit_action_cancel}}</span></button>
			{{/feature.cancel}}
			{{#feature.save}}
			<button title="{{imgedit_message_save}}" type="button" class="wc_btn_save {{style.btnclass}}" name="save"><i aria-hidden="true" class="wc-fa fa-regular fa-floppy-disk"></i><span class="{{style.textclass}}">{{imgedit_action_save}}</span></button>
			{{/feature.save}}
		</div>
	</div>
</div>
